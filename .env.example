# Chave da Gemini API (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=coloque_sua_chave_aqui

# Modelo usado pelos agentes (opcional)
BANCO_AGIL_MODELO=gemini-3.1-flash-lite

# Temperatura do modelo (opcional). Deixe vazio nos modelos Gemini 3.x,
# que usam amostragem fixa e ignoram o parametro.
BANCO_AGIL_TEMPERATURA=

# Endpoint de cotacao de moedas (opcional)
BANCO_AGIL_API_CAMBIO=https://economia.awesomeapi.com.br/json/last

# Modo demonstracao: mostra no painel lateral os CPFs e datas de nascimento
# dos clientes de teste, para o avaliador conseguir se autenticar.
# Desligue (false) em qualquer uso que nao seja demonstracao.
BANCO_AGIL_MODO_DEMO=true
