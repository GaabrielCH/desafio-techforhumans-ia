# Segredos do Streamlit Community Cloud.
#
# NAO comite o arquivo real (.streamlit/secrets.toml) - ele esta no
# .gitignore. No deploy, cole este conteudo em:
#   painel do app -> Settings -> Secrets
#
# Localmente o projeto le do .env; este arquivo so e necessario na nuvem.

GOOGLE_API_KEY = "sua_chave_da_gemini_api_aqui"
BANCO_AGIL_MODELO = "gemini-3.1-flash-lite"
BANCO_AGIL_MODO_DEMO = "true"
